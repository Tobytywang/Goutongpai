data/

# 界面回归截图输出
.preview/

# 依赖（本项目零依赖，留作占位）
node_modules/

# 系统与编辑器
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/

# 密钥与证书（绝不进仓库）
.env
.env.*
*.pem
*.key
*.crt

# WorkBuddy 本地项目数据（记忆/缓存，非源码）
