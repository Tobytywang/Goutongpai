<view class="page">
  <!-- 顶部：应用名 + 当前版本 + 基础库版本 -->
  <view class="card about-hero">
    <view class="about-hero__name">沟通牌</view>
    <view class="about-hero__meta">版本 {{appVersion}}</view>
    <view class="about-hero__meta">基础库 {{sdkVersion || '—'}}</view>
  </view>

  <!-- 历史版本发布说明 -->
  <view class="about-section-label">功能介绍</view>
  <view class="card about-list">
    <view wx:for="{{releases}}" wx:key="version" class="about-item">
      <view class="about-item__row" hover-class="about-item__row--hover" bindtap="toggle" data-version="{{item.version}}">
        <view class="about-item__main">
          <view class="about-item__title">沟通牌 {{item.version}} {{item.title}}</view>
          <view wx:if="{{item.date}}" class="about-item__date">{{item.date}}</view>
        </view>
        <text class="about-item__arrow {{expanded === item.version ? 'about-item__arrow--open' : ''}}">›</text>
      </view>
      <view wx:if="{{expanded === item.version}}" class="about-item__notes">
        <view wx:for="{{item.notes}}" wx:for-item="note" wx:key="*this" class="about-item__note">{{note}}</view>
      </view>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>
