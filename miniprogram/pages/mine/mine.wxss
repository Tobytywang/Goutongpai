/* 通用样式见 app.wxss */

/* 我的页顶部固定区：seg 导航 + 当前 tab 的头部卡片，整体吸顶不随列表滚动 */
.mine-sticky-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--color-bg);
  /* 把原本由 .seg margin-top 漏出的顶部灰色间距，变成父容器自身的 padding，
     避免吸顶时 margin 被收回导致上方空间突然变小 */
  padding-top: var(--space-md);
}
.mine-sticky-header .seg {
  margin-top: 0;
}

/* 设置页「关于沟通牌」行右侧的版本+箭头：不用全局 .row-between（其自带
   margin-bottom 会在卡片垂直居中时把内容抬高半格），改用 gap 排布 */
.about-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 设置页三个卡片行（关于沟通牌 / 隐私政策 / 登录身份）：卡片默认上下内边距只有
   space-sm(16rpx)，单行小字会显得过矮；加高到与列表行 .list-item 一致的 space-md(24rpx) */
.card.settings-row {
  padding-top: var(--space-md);
  padding-bottom: var(--space-md);
}
