<view class="page">
  <!-- 加载失败 -->
  <view wx:if="{{error}}" class="card muted">{{error}}</view>

  <!-- 新建技能：表单常驻（与计分台一致），名称 / 输入框 / 保存同属一行 -->
  <view class="card">
    <view class="card-head">
      <view class="title">技能（{{skills.length}}）</view>
    </view>
    <view class="form skill-form">
      <view class="form-row skill-form__row">
        <text class="form-label form-label--justify">名称</text>
        <input class="input skill-form__input" placeholder="技能名称（最多8个字）" placeholder-class="placeholder-left" value="{{newName}}" maxlength="8" bindinput="onNewName" />
        <view class="btn-slot">
          <button class="btn-primary mini" hover-class="btn-hover" catchtap="submitSkill">保存</button>
        </view>
      </view>
      <view class="skill-tip muted">技能赛里每位玩家都要选技能；已被对局引用的技能不能删除，可直接改名，历史记录会自动跟随。</view>
    </view>
  </view>

  <!-- 技能列表：展示行常驻不动，编辑态在其下方缩进展开（与计分台技能行同构） -->
  <view wx:if="{{skills.length}}" class="card">
    <view wx:for="{{skills}}" wx:key="id" class="skill-item">
      <view class="skill-row">
        <view class="skill-row__main">
          <text class="name">{{item.name}}</text>
          <text class="muted skill-row__usage">· {{item.usageCount}} 条引用</text>
        </view>
        <view class="skill-row__actions">
          <button wx:if="{{item.id !== editingId}}" class="btn-ghost mini" hover-class="btn-hover" catchtap="openEdit" data-id="{{item.id}}">编辑</button>
          <button wx:else class="btn-ghost mini" hover-class="btn-hover" catchtap="cancelEdit">收起</button>
          <button class="btn-danger mini {{item.usageCount > 0 ? 'btn-disabled' : ''}}" disabled="{{item.usageCount > 0}}" hover-class="btn-hover" catchtap="deleteSkill" data-id="{{item.id}}">删除</button>
        </view>
      </view>
      <!-- 编辑展开区：左侧主色竖线 + 缩进，表明从属于上方技能行；位置不跳、上下文还在。
           不加「正在编辑」提示——上方展示行本身就是技能名，重复且占高 -->
      <view wx:if="{{item.id === editingId}}" class="skill-edit" catchtap="noop">
        <view class="skill-edit__form">
          <text class="form-label form-label--justify">新名称</text>
          <input class="input skill-edit__input" placeholder="技能名称（最多8个字）" placeholder-class="placeholder-left" value="{{editName}}" maxlength="8" bindinput="onEditName" />
          <view class="btn-slot">
            <button class="btn-ghost mini" hover-class="btn-hover" catchtap="cancelEdit">取消</button>
          </view>
          <view class="btn-slot">
            <button class="btn-primary mini" hover-class="btn-hover" catchtap="submitEdit">保存</button>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>

<!-- 删除技能的二次确认模态框 -->
<confirm-modal id="confirmModal" />
